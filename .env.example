DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clinic_care?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-before-production"
# Pemulihan password via Resend. Verifikasi domain pengirim sebelum dipakai.
APP_BASE_URL="https://clinic-care-zeta.vercel.app"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="KlinikCare <no-reply@your-domain.example>"
