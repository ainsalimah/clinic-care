generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PATIENT
  RECEPTIONIST
  DOCTOR
  PHARMACIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_EXAMINATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_ROOM
  COMPLETED
  SKIPPED
}

enum PrescriptionStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient   Patient?
  doctor    Doctor?
  guardians PatientGuardian[]
  sessions AuthSession[]
}

model AuthSession {
  id        String   @id
  userId    String
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Patient {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  medicalRecordNo       String   @unique
  nik                   String?  @unique
  fullName              String
  dateOfBirth           DateTime
  gender                String   @default("MALE")
  address               String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians     PatientGuardian[]
  appointments  Appointment[]
  records       MedicalRecord[]
  prescriptions Prescription[]
}

model PatientGuardian {
  id           String   @id @default(cuid())
  patientId    String
  userId       String
  relationship String
  createdAt    DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([patientId, userId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  doctors      Doctor[]
  schedules    Schedule[]
  appointments Appointment[]
  queues       Queue[]
}

model Doctor {
  consultationFee Int @default(100000)
  id             String   @id @default(cuid())
  userId         String   @unique
  departmentId   String
  fullName       String
  specialization String?
  roomLabel      String?
  licenseNumber  String?
  createdAt      DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department      @relation(fields: [departmentId], references: [id])
  schedules     Schedule[]
  appointments  Appointment[]
  records       MedicalRecord[]
  prescriptions Prescription[]
}

model Schedule {
  id           String   @id @default(cuid())
  doctorId     String
  departmentId String
  dayOfWeek    Int
  startTime    String
  endTime      String
  quota        Int      @default(20)
  createdAt    DateTime @default(now())

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  bill Bill?
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  departmentId    String
  scheduleId      String?
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient    Patient        @relation(fields: [patientId], references: [id])
  doctor     Doctor         @relation(fields: [doctorId], references: [id])
  department Department     @relation(fields: [departmentId], references: [id])
  schedule   Schedule?      @relation(fields: [scheduleId], references: [id])
  queue      Queue?
  record     MedicalRecord?
}

model Queue {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  departmentId  String
  queueNumber   String
  status        QueueStatus @default(WAITING)
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id])
}

model QueueAutoCall {
  id                  String    @id @default(cuid())
  doctorId            String
  sourceAppointmentId String    @unique
  dueAt               DateTime
  cancelledAt         DateTime?
  processedAt         DateTime?
  calledQueueId       String?
  createdAt           DateTime  @default(now())

  @@index([dueAt, processedAt, cancelledAt])
}

model QueueAnnouncement {
  id           String    @id @default(cuid())
  queueId      String
  doctorId     String
  queueNumber  String
  roomLabel    String
  createdAt    DateTime  @default(now())
  claimToken   String?
  claimedUntil DateTime?
  playedAt     DateTime?

  @@index([playedAt, claimedUntil, createdAt])
}

model MedicalRecord {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  complaint     String?
  physicalExam  String?
  diagnosis     String?
  treatment     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment  Appointment   @relation(fields: [appointmentId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  prescription Prescription?
}

model Medicine {
  reservedStock Int @default(0)
  id           String   @id @default(cuid())
  name         String
  form         String?
  unit         String
  price        Float    @default(0)
  stock        Int      @default(0)
  minimumStock Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        PrescriptionItem[]
  transactions InventoryTransaction[]
}

model Prescription {
  id              String             @id @default(cuid())
  medicalRecordId String             @unique
  patientId       String
  doctorId        String
  status          PrescriptionStatus @default(PENDING)
  notes           String?
  dispensedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  medicalRecord MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  patient       Patient            @relation(fields: [patientId], references: [id])
  doctor        Doctor             @relation(fields: [doctorId], references: [id])
  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  medicineId     String
  dosage         String
  quantity       Int
  instruction    String

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])
}

model InventoryTransaction {
  id          String                   @id @default(cuid())
  medicineId  String
  type        InventoryTransactionType
  quantity    Int
  notes       String?
  referenceId String?
  createdAt   DateTime                 @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id])
}

model Bill {
  id String @id @default(cuid())
  appointmentId String @unique
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patientName String
  medicalRecordNo String
  total Int
  paidAt DateTime?
  paymentMethod String?
  receivedAmount Int?
  receivedBy String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  items BillItem[]
  @@index([paidAt, createdAt])
}

model BillItem {
  id String @id @default(cuid())
  billId String
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity Int
  unit String
  unitPrice Int
  amount Int
}
