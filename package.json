{
  "name": "clinic-care",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prestart": "node scripts/check-production-env.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test src/lib/clinic-time.test.ts src/lib/access.test.ts src/lib/rate-limit.test.ts src/lib/prescription-rules.test.ts src/lib/billing-rules.test.ts src/lib/payment-report.test.ts src/lib/password-rules.test.ts",
    "test:billing:integration": "tsx scripts/test-billing-integration.ts",
    "test:visit:e2e": "tsx scripts/test-visit-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
